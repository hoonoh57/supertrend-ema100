# Kiwoom REST API credentials
# The engine reads the project .env first, then the file in
# SUPERTREND_ENV_FILE. Never commit real keys.
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_SECRET_KEY=
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
# true = 모의투자 서버, false = 실전투자 서버
KIWOOM_USE_MOCK=true

# Optional generic aliases (used when the prefixed names are absent)
# KIWOOM_APP_KEY=
# KIWOOM_SECRET_KEY=
